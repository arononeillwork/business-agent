# Built JS/CSS have a content hash in their name, so a new deploy always gets new file names:
# browsers keep them for a year. Pages (index.html) stay "check every time" (Cloudflare's
# default), so the next load after a deploy always shows the new version.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker (push notifications, the app on a phone): browsers check it for a new version on every visit.
/push-sw.js
  Cache-Control: no-cache
