{
  "name": "business-agent-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The landing page's demo video: the real app recorded in demo mode, composed with Remotion.",
  "scripts": {
    "capture": "node capture/run.mjs",
    "capture:day": "node capture/day.mjs",
    "capture:owner": "node capture/owner.mjs",
    "capture:waste": "node capture/waste.mjs",
    "capture:listing": "node capture/listing.mjs",
    "capture:competitors": "node capture/competitors.mjs",
    "capture:regulars": "node capture/regulars.mjs",
    "capture:costing": "node capture/costing.mjs",
    "capture:social": "node capture/social.mjs",
    "capture:rota": "node capture/rota.mjs",
    "capture:hours": "node capture/hours.mjs",
    "music": "python3 music/compose.py",
    "music:day": "python3 music/day.py",
    "music:owner": "python3 music/owner.py",
    "music:say": "python3 music/say.py",
    "music:waste": "python3 music/waste.py",
    "music:listing": "python3 music/listing.py",
    "music:competitors": "python3 music/competitors.py",
    "music:regulars": "python3 music/regulars.py",
    "music:costing": "python3 music/costing.py",
    "music:social": "python3 music/social.py",
    "music:rota": "python3 music/rota.py",
    "music:hours": "python3 music/hours.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LandingVideo out/landing-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:day": "remotion render src/index.ts DayVideo out/day-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:owner": "remotion render src/index.ts OwnerVideo out/owner-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:say": "remotion render src/index.ts SayVideo out/say-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:waste": "remotion render src/index.ts WasteVideo out/waste-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:listing": "remotion render src/index.ts ListingVideo out/listing-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:competitors": "remotion render src/index.ts CompetitorsVideo out/competitors-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:regulars": "remotion render src/index.ts RegularsVideo out/regulars-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:costing": "remotion render src/index.ts CostingVideo out/costing-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:social": "remotion render src/index.ts SocialVideo out/social-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:rota": "remotion render src/index.ts RotaVideo out/rota-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:hours": "remotion render src/index.ts HoursVideo out/hours-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "web": "node web.mjs landing",
    "web:day": "node web.mjs day",
    "web:owner": "node web.mjs owner",
    "web:say": "node web.mjs say",
    "web:waste": "node web.mjs waste",
    "web:listing": "node web.mjs listing",
    "web:competitors": "node web.mjs competitors",
    "web:regulars": "node web.mjs regulars",
    "web:costing": "node web.mjs costing",
    "web:social": "node web.mjs social",
    "web:rota": "node web.mjs rota",
    "web:hours": "node web.mjs hours",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
