{
  "name": "business-agent-video",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The landing page's demo video: the real app recorded in demo mode, composed with Remotion.",
  "scripts": {
    "capture": "node capture/run.mjs",
    "capture:day": "node capture/day.mjs",
    "capture:owner": "node capture/owner.mjs",
    "capture:waste": "node capture/waste.mjs",
    "music": "python3 music/compose.py",
    "music:day": "python3 music/day.py",
    "music:owner": "python3 music/owner.py",
    "music:say": "python3 music/say.py",
    "music:waste": "python3 music/waste.py",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts LandingVideo out/landing-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:day": "remotion render src/index.ts DayVideo out/day-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:owner": "remotion render src/index.ts OwnerVideo out/owner-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:say": "remotion render src/index.ts SayVideo out/say-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "render:waste": "remotion render src/index.ts WasteVideo out/waste-master.mp4 --codec=h264 --crf=16 --audio-bitrate=192k",
    "web": "node web.mjs landing",
    "web:day": "node web.mjs day",
    "web:owner": "node web.mjs owner",
    "web:say": "node web.mjs say",
    "web:waste": "node web.mjs waste",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/media": "4.0.539",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "simple-icons": "^16.36.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
