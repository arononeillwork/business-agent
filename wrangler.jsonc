{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-agent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*"]
  },
  "observability": { "enabled": true },
  // OAuth grants/tokens for the AI connector (encrypted by workers-oauth-provider).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0305794e6d204a83b4c49c5ec36a85cd" }],
  // Every 5 minutes: auto clock-out, expire old correction requests.
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "BUSINESS_ID": "easy-beans",
    // Public by design (row-level security protects the data). Service key is a secret:
    //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
    "SUPABASE_URL": "https://lhakrmmoxaareykglmtx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_FN8O4JMcZa7hmiSlZSo1uQ_vBM1S05e"
  }
}
