{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "business-agent",
  // Cloudflare account (not a secret; lets account-owned API tokens deploy).
  "account_id": "c7451083f0bc060b947b1b188291cb4b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/cal/*", "/mcp", "/mcp/*", "/authorize", "/token", "/register", "/.well-known/*",
      // Self-destructing service worker for browsers that kept one from an earlier site (worker/index.ts).
      "/sw.js", "/service-worker.js", "/serviceworker.js", "/registerSW.js", "/worker.js",
      // Code files: one that isn't there is a 404, never the app's page (worker/index.ts).
      "/assets/*",
      // The landing page's videos, a part at a time (worker/video.ts).
      "/video/*"]
  },
  "observability": { "enabled": true },
  // OAuth grants/tokens for the AI connector (encrypted by workers-oauth-provider).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0305794e6d204a83b4c49c5ec36a85cd" }],
  // Every minute: auto clock-out, shift alerts, deliver the outbox. Nightly: fill timecards from the rota.
  // Every minute from 02:00 to 03:59 UTC: the night's connection checks, a few at a time (worker/index.ts).
  "triggers": { "crons": ["* * * * *", "15 1 * * *", "* 2-3 * * *"] },
  // Photos for Instagram / Google posts (served publicly at /media/*). Enable R2 in the
  // Cloudflare dashboard, create the bucket "business-agent-media", then uncomment:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "business-agent-media" }],
  "vars": {
    "BUSINESS_ID": "easy-beans",
    // Public by design (row-level security protects the data). Service key is a secret:
    //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
    "SUPABASE_URL": "https://lhakrmmoxaareykglmtx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_FN8O4JMcZa7hmiSlZSo1uQ_vBM1S05e",
    // Meta (WhatsApp + Instagram). The ids and tokens are GitHub repo secrets that the deploy
    // copies to the Worker (scripts/ops/worker-secrets.mjs): META_ACCESS_TOKEN, META_APP_SECRET,
    // WHATSAPP_VERIFY_TOKEN, WHATSAPP_PHONE_NUMBER_ID, INSTAGRAM_USER_ID. Same for Google and
    // Spotify. INTEGRATION_KEY and the Supabase service key are made by the deploy itself.
    "META_GRAPH_VERSION": "v23.0",
    "WHATSAPP_TEMPLATE_LANG": "es",
    // The platforms whose statistics permissions sign-in asks for (Analytics; docs/INTEGRATIONS.md). Add one only
    // once its developer app has them: Instagram and TikTok refuse a sign-in asking for a permission the app lacks.
    "STATS_SCOPES": "instagram,tiktok"
  }
}
