{
  "name": "business-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "wrangler types && tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "wrangler types && tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "test:db": "scripts/test-db.sh",
    "test:e2e": "playwright test e2e/demo.spec.ts",
    "test:e2e:live": "NODE_USE_ENV_PROXY=1 E2E_LIVE=1 playwright test e2e/live.spec.ts --project desktop"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/server": "^2.1.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.13.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^16.33.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
