{
  // The camera upload server (cameras/server.ts runs on Node 24 as TypeScript: types are only
  // stripped, so nothing that needs compiling, such as constructor parameter properties or enums).
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.cameras.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["cameras/*.ts"]
}
